+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+process.env.DORM_DB = ":memory:";
+const { accountLogin, user, login, logout } = await import("../lib/db.ts");
+const { act, browse, detail } = await import("../lib/service.ts");
+test("독립 세션으로 가입한 공동 캠퍼스 계정은 같은 기숙사 공구만 공유한다", () => {
+  const reg = (handle: string, dorm: string) => ({
+    handle,
+    password: randomUUID(),
+    dorm,
+    notify: true,
+  });
+  const a = reg("shared-host", "A"),
+    b = reg("shared-student", "A"),
+    c = reg("other-student", "B");
+  const host = user(accountLogin(a, true)),
+    student = user(accountLogin(b, true)),
+    other = user(accountLogin(c, true));
+  const demo = user(login("", "operator", "A", true).session);
+  const t = Date.now() + 86400000;
+  const id = act(host, {
+    action: "create",
+    name: "휴지",
+    qty: 30,
+    lots: 2,
+    price: 7000,
+    url: "https://example.org/product",
+    image: "/art/tissue.webp",
+    category: "생활용품",
+    mode: "equal",
+    deadline: t,
+    orderAt: t,
+    pickup: t,
+    place: "로비",
+    agree: Array(5).fill(true),
+  }).id!;
+  assert.equal(browse(student).groups[0].id, id);
+  assert.throws(() => detail(other, id));
+  assert.throws(() => detail(demo, id));
+  act(student, { action: "join", id, lots: 1 });
+  assert.equal(detail(host, id).people, 1);
+  assert.equal(host.role, "student");
+  assert.throws(() => accountLogin({ ...a, password: randomUUID() }, false));
+  const s = accountLogin(a, false);
+  assert.equal(user(s).id, host.id);
+  logout(s);
+  assert.equal(user(s), undefined);
+});
diff --git a/tests/pages-postgres.mjs b/tests/pages-postgres.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fba69804942700375c07689baf7b56f44cc5f4d3
--- /dev/null
+++ b/tests/pages-postgres.mjs
@@ -0,0 +1,97 @@
+import assert from "node:assert/strict";
+const origin = "https://yang051228.github.io";
+async function api(path, data, session, spaceKey) {
+  const res = await fetch(
+    (process.env.MOADAM_TEST_API || "http://127.0.0.1:8000/moadam") +
+      "/" +
+      path,
+    {
+      method: data ? "POST" : "GET",
+      headers: {
+        origin,
+        "content-type": "application/json",
+        "x-moadam-session": session || "",
+        "x-moadam-space": spaceKey || "",
+      },
+      body: data ? JSON.stringify(data) : undefined,
+    },
+  );
+  const v = await res.json();
+  if (!res.ok) throw Error(path + " " + JSON.stringify(v));
+  return v;
+}
+const demo = await api("login", { account: "member", dorm: "A" }),
+  home = await api("home", null, demo.session);
+assert.equal(home.groups.length, 12);
+const deal = home.groups.find(
+  (g) => g.name.includes("화장지") && g.status === "open",
+);
+await api("act", { action: "join", id: deal.id, lots: 1 }, demo.session);
+assert.equal((await api("buy/" + deal.id, null, demo.session)).status, "full");
+await api("act", { action: "cancel", id: deal.id }, demo.session);
+assert.equal((await api("buy/" + deal.id, null, demo.session)).status, "open");
+const operator = await api(
+  "login",
+  { account: "operator", dorm: "A" },
+  demo.session,
+  demo.spaceKey,
+);
+assert.ok((await api("admin", null, operator.session)).rows.length);
+const pass = "test-password-12345",
+  prefix = "m" + Date.now();
+async function account(s, dorm = "A") {
+  return (
+    await api("signup", {
+      handle: prefix + s,
+      password: pass,
+      dorm,
+      notify: true,
+    })
+  ).session;
+}
+const host = await account("host"),
+  one = await account("one"),
+  two = await account("two"),
+  other = await account("other", "B");
+const now = Date.now();
+const { id } = await api(
+  "act",
+  {
+    action: "create",
+    name: "시험 공구",
+    image: "/art/tissue.webp",
+    url: "https://example.org",
+    price: 3150,
+    qty: 5,
+    lots: 1,
+    mode: "equal",
+    deadline: now + 600000,
+    orderAt: now + 900000,
+    pickup: now + 1000000,
+    place: "로비",
+    category: "생활용품",
+    agree: [true, true, true, true, true],
+  },
+  host,
+);
+assert.equal((await api("home", null, other)).groups.length, 0);
+await assert.rejects(api("buy/" + id, null, other));
+const race = await Promise.allSettled(
+  [one, two].map((s) => api("act", { action: "join", id, lots: 1 }, s)),
+);
+assert.equal(race.filter((x) => x.status === "fulfilled").length, 1);
+const winner = race[0].status === "fulfilled" ? one : two;
+for (const to of ["pending", "ordered", "shipping"])
+  await api("act", { action: "advance", id, to }, host);
+for (let bit = 0; bit < 5; bit++)
+  await api("act", { action: "check", id, bit, checked: true }, host);
+await api("act", { action: "advance", id, to: "ready" }, host);
+await api("act", { action: "receive", id }, winner);
+const g = await api("buy/" + id, null, host);
+await api("act", { action: "handoff", id, pid: g.members[0].id }, host);
+await api("act", { action: "advance", id, to: "done" }, host);
+const fresh = await api("signin", { handle: prefix + "host", password: pass });
+assert.equal((await api("buy/" + id, null, fresh.session)).status, "done");
+console.log(
+  "PASS demo, admin, two accounts, dorm isolation, race, order, pickup, sign-in",
+);
diff --git a/tests/race.test.ts b/tests/race.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79374d087a7c4151538d330cbe46018fae664b42
--- /dev/null
+++ b/tests/race.test.ts
@@ -0,0 +1,42 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { spawn } from "node:child_process";
+test("독립 SQLite 연결 두 개가 마지막 단위에 동시에 신청하면 한 건만 확정", async () => {
+  const dir = mkdtempSync(join(tmpdir(), "dorm-race-"));
+  process.env.DORM_DB = join(dir, "race.sqlite");
+  const { login, user, db } = await import("../lib/db.ts");
+  const { browse, detail } = await import("../lib/service.ts");
+  try {
+    const { session, spaceKey } = login("", "member", "A", true),
+      host = login(spaceKey, "host", "A", true);
+    const student = user(session),
+      g = browse(student).groups.find(
+        (g) => g.name.includes("화장지") && g.status === "open",
+      );
+    const until = Date.now() + 1000;
+    const attempt = (key: string) =>
+      new Promise<number>((ok, fail) => {
+        const code = `import {user} from './lib/db.ts';import {act} from './lib/service.ts';const [s,id,t]=process.argv.slice(1);await new Promise(r=>setTimeout(r,Math.max(0,Number(t)-Date.now())));try{act(user(s),{action:'join',id:Number(id),lots:1})}catch(e){process.exitCode=2}`;
+        const child = spawn(
+          process.execPath,
+          ["--input-type=module", "-e", code, key, String(g.id), String(until)],
+          { stdio: "ignore" },
+        );
+        child.on("error", fail);
+        child.on("exit", (c) => ok(c ?? 99));
+      });
+    assert.deepEqual(
+      (await Promise.all([attempt(session), attempt(host.session)])).sort(),
+      [0, 2],
+    );
+    const result = detail(student, g.id);
+    assert.equal(result.used, result.lots);
+    assert.equal(result.status, "full");
+  } finally {
+    db.close();
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
diff --git a/tests/workflow.test.ts b/tests/workflow.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2b1be705645d93694a64be871172d3306eeb4248
--- /dev/null
+++ b/tests/workflow.test.ts
@@ -0,0 +1,214 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+process.env.DORM_DB = ":memory:";
+const { login, user, one, run, db, tx, sweep } = await import("../lib/db.ts");
+const { act, detail, browse, admin } = await import("../lib/service.ts");
+const { day } = await import("../lib/catalog.ts");
+function setup() {
+  const a = login("", "member", "A", true);
+  const account = (role: string, d = "A") =>
+    user(login(a.spaceKey, role, d, true).session);
+  return {
+    student: user(a.session),
+    host: account("host"),
+    op: account("operator"),
+    b: account("member", "B"),
+  };
+}
+function create(u: any, n = 2, mode = "units") {
+  const t = Date.now();
+  return act(u, {
+    action: "create",
+    name: "테스트 물품",
+    image: "/art/wipes.webp",
+    url: "https://example.org/product",
+    price: 10001,
+    qty: 6,
+    lots: n,
+    mode,
+    category: "생활용품",
+    deadline: t + day,
+    orderAt: t + 2 * day,
+    pickup: t + 3 * day,
+    place: "1층",
+    agree: Array(5).fill(true),
+  }).id!;
+}
+const step = (u: any, id: number, to: string) =>
+  act(u, { action: "advance", id, to });
+function ready(host: any, id: number) {
+  for (const s of ["pending", "ordered", "shipping"]) step(host, id, s);
+  assert.throws(() => step(host, id, "ready"));
+  for (let bit = 0; bit < 5; bit++)
+    act(host, { action: "check", id, bit, checked: true });
+  step(host, id, "ready");
+}
+test("1. 운영자 휴지 공구 마지막 자리 참여 → 주문 → 양측 수령 → 종료", () => {
+  const { student, op } = setup();
+  const g = browse(student).groups.find(
+    (g) => g.status === "open" && g.name.includes("화장지"),
+  );
+  assert.equal(g.lots - g.used, 1);
+  act(student, { action: "join", id: g.id, lots: 1 });
+  assert.equal(detail(student, g.id).mine.amount, 3150);
+  assert.equal(detail(op, g.id).status, "full");
+  ready(op, g.id);
+  for (const p of detail(op, g.id).members) {
+    const u = { ...student, id: p.uid };
+    act(u, { action: "receive", id: g.id });
+    act(op, { action: "handoff", id: g.id, pid: p.id });
+  }
+  step(op, g.id, "done");
+  assert.equal(detail(student, g.id).status, "done");
+});
+test("2. 학생 개설 · 지정 수량 · 원 단위 잔액 · 분배 준비 · 종료", () => {
+  const { student, host, op } = setup(),
+    id = create(host);
+  act(student, { action: "join", id, lots: 1 });
+  act(op, { action: "join", id, lots: 1 });
+  const g = detail(host, id);
+  assert.equal(
+    g.members.reduce((a: number, m: any) => a + m.amount, 0),
+    10001,
+  );
+  ready(host, id);
+  for (const u of [student, op]) {
+    act(u, { action: "receive", id });
+    act(host, { action: "handoff", id, pid: detail(u, id).mine.id });
+  }
+  step(host, id, "done");
+  assert.equal(detail(host, id).status, "done");
+});
+test("3. 마감 미달 · 알림 · 모의 결제 취소 · 재개설", () => {
+  const { host, student } = setup(),
+    id = create(host);
+  act(student, { action: "join", id, lots: 1 });
+  run("UPDATE group_buys SET deadline=0 WHERE id=?", id);
+  let g = detail(host, id);
+  assert.equal(g.status, "failed");
+  assert.equal(g.members[0].payment, "void");
+  assert.throws(() => act(host, { action: "join", id, lots: 1 }));
+  assert.ok(browse(student).notifications.some((n) => n.body === "모집 실패"));
+  assert.notEqual(create(host), id);
+});
+test("4. 마감 전 취소·재참여 및 주문 후 요청 검토", () => {
+  const { host, student, op } = setup(),
+    id = create(host);
+  act(student, { action: "join", id, lots: 2 });
+  act(student, { action: "cancel", id });
+  assert.equal(detail(host, id).used, 0);
+  act(student, { action: "join", id, lots: 2 });
+  step(host, id, "pending");
+  step(host, id, "ordered");
+  act(student, { action: "cancel", id });
+  assert.equal(detail(host, id).used, 2);
+  const r = detail(op, id).requests.at(-1);
+  act(op, { action: "resolveCancel", id, request: r.id, result: "승인" });
+  assert.equal(detail(host, id).used, 0);
+  assert.equal(detail(op, id).requests.at(-1).result, "승인");
+});
+test("5. 미수령 알림 → 재수령 일정 접수 → 처리 → 전달 확인", () => {
+  const { host, student, op } = setup(),
+    id = create(host);
+  for (const u of [student, op]) act(u, { action: "join", id, lots: 1 });
+  ready(host, id);
+  act(op, { action: "receive", id });
+  act(host, { action: "handoff", id, pid: detail(op, id).mine.id });
+  assert.throws(() => step(host, id, "done"));
+  run("UPDATE pickup_schedules SET at=0 WHERE buy=?", id);
+  const n = browse(student).notifications;
+  assert.ok(n.some((n) => n.body.includes("재수령")));
+  act(student, {
+    action: "issue",
+    id,
+    kind: "재수령 일정",
+    body: "내일 14시 희망",
+  });
+  const issue = detail(host, id).issues[0];
+  act(host, {
+    action: "resolve",
+    id,
+    issue: issue.id,
+    result: "내일 14시 로비에서 전달",
+  });
+  act(student, { action: "receive", id });
+  act(host, { action: "handoff", id, pid: detail(student, id).mine.id });
+  step(host, id, "done");
+});
+test("권한 · 공간 격리 · 중복 참여 · 수량 초과 · 채팅 권한 · 순서 역행 차단", () => {
+  const { host, student, op, b } = setup(),
+    id = create(host);
+  const other = setup();
+  assert.throws(() => detail(b, id));
+  assert.throws(() => detail(other.student, id));
+  assert.throws(() => admin(student));
+  assert.throws(() => act(student, { action: "advance", id, to: "failed" }));
+  assert.throws(() => act(host, { action: "advance", id, to: "ordered" }));
+  assert.throws(() => act(student, { action: "join", id, lots: 3 }));
+  assert.throws(() => act(op, { action: "chat", id, body: "열람" }));
+  act(student, { action: "join", id, lots: 1 });
+  assert.throws(() => act(student, { action: "join", id, lots: 1 }));
+  act(student, { action: "chat", id, body: "안녕하세요" });
+  assert.equal(detail(host, id).messages.length, 1);
+  assert.equal(detail(op, id).messages.length, 0);
+  assert.throws(() => act(op, { action: "join", id, lots: 2 }));
+  assert.equal(detail(host, id).used, 1);
+  assert.throws(() => login("", "root", "A", true));
+});
+test("주문 지연 · 알림 중복 방지 · 운영자 중단", () => {
+  const { host, student, op } = setup(),
+    id = create(host);
+  act(student, { action: "join", id, lots: 2 });
+  run("UPDATE group_buys SET order_at=? WHERE id=?", Date.now() - 2 * day, id);
+  tx(sweep);
+  tx(sweep);
+  assert.equal(
+    browse(op).notifications.filter(
+      (n) => n.buy === id && n.body.includes("지연"),
+    ).length,
+    1,
+  );
+  act(op, { action: "stop", id });
+  assert.equal(detail(host, id).members[0].payment, "void");
+});
+test("균등 분배 검증·사진 신고·운영자 통계", () => {
+  const { host, student, op } = setup();
+  assert.throws(() => create(host, 4));
+  const id = create(host, 2, "equal");
+  assert.throws(() => act(student, { action: "join", id, lots: 2 }));
+  act(student, { action: "join", id, lots: 1 });
+  act(student, {
+    action: "issue",
+    id,
+    kind: "파손",
+    body: "포장 파손",
+    photo: "data:image/png;base64,AA==",
+  });
+  assert.ok(detail(host, id).issues[0].photo);
+  assert.ok(admin(op).entries.some((r) => r.buy === id));
+});
+test("미수령 분쟁은 운영자가 사유와 처리 결과를 기록한 뒤 종결한다", () => {
+  const { host, student, op } = setup(),
+    id = create(host);
+  act(student, { action: "join", id, lots: 2 });
+  ready(host, id);
+  act(student, {
+    action: "issue",
+    id,
+    kind: "누락",
+    body: "수령할 물품이 없음",
+  });
+  const issue = detail(op, id).issues[0].id;
+  assert.throws(() =>
+    act(host, { action: "resolve", id, issue, result: "합의", dispute: true }),
+  );
+  act(op, {
+    action: "resolve",
+    id,
+    issue,
+    result: "수량 누락 확인, 해당 분담금 모의 취소에 합의",
+    dispute: true,
+  });
+  step(host, id, "done");
+  assert.equal(detail(op, id).issues[0].status, "done");
+});
