@@ -0,0 +1,68 @@
+import { login, logout, accountLogin, user } from "./db.ts";
+import { browse, detail, admin, act } from "./service.ts";
+
+const origin = Deno.env.get("MOADAM_ORIGIN") || "https://yang051228.github.io";
+Deno.serve(async (req) => {
+  const headers = {
+    "access-control-allow-origin": origin,
+    "access-control-allow-headers":
+      "content-type, x-moadam-session, x-moadam-space, apikey",
+    "access-control-allow-methods": "GET, POST, OPTIONS",
+    "cache-control": "no-store",
+    vary: "Origin",
+  };
+  const json = (value: unknown, status = 200) =>
+    Response.json(value, { headers, status });
+  if (req.headers.get("origin") !== origin)
+    return json({ error: "허용되지 않은 출처예요." }, 403);
+  if (req.method === "OPTIONS")
+    return new Response(null, { status: 204, headers });
+  const path = new URL(req.url).pathname.split("/moadam/").pop();
+  const session = req.headers.get("x-moadam-session") || "";
+  try {
+    const me = session ? await user(session) : null;
+    if (req.method === "GET") {
+      if (!me)
+        return path === "home"
+          ? json({ me: null })
+          : json({ error: "로그인이 필요해요." }, 401);
+      if (path === "home") return json(await browse(me));
+      if (path === "admin") return json(await admin(me));
+      if (path && /^buy\/\d+$/.test(path))
+        return json(await detail(me, Number(path.slice(4))));
+    } else if (req.method === "POST") {
+      const body = await req.text();
+      if (body.length > 800000)
+        return json({ error: "첨부파일을 줄여 주세요." }, 413);
+      const input = JSON.parse(body || "{}");
+      if (path === "login" || path === "signin" || path === "signup") {
+        const result =
+          path === "login"
+            ? await login(
+                req.headers.get("x-moadam-space") || "",
+                input.account,
+                input.dorm,
+                input.notify !== false,
+              )
+            : { session: await accountLogin(input, path === "signup") };
+        if (session) await logout(session);
+        return json(result);
+      }
+      if (!me) return json({ error: "로그인이 필요해요." }, 401);
+      if (path === "logout") {
+        await logout(session);
+        return json({ ok: true });
+      }
+      if (path === "act") return json(await act(me, input));
+    }
+    return json({ error: "요청을 찾을 수 없어요." }, 404);
+  } catch (err) {
+    const message =
+      err instanceof Error &&
+      err.name === "Error" &&
+      /[가-힣]/.test(err.message)
+        ? err.message
+        : "요청을 처리하지 못했어요. 입력값을 확인해 주세요.";
+    return json({ error: message }, 400);
+  }
+});
