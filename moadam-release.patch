+++ b/supabase/functions/moadam/postgres.ts
@@ -0,0 +1,57 @@
+import postgres from "npm:postgres@3.4.7";
+import { AsyncLocalStorage } from "node:async_hooks";
+
+const database = postgres(Deno.env.get("SUPABASE_DB_URL")!, {
+  prepare: false,
+  max: 1,
+  types: {
+    numericResult: {
+      to: 20,
+      from: [20, 1700],
+      serialize: String,
+      parse: Number,
+    },
+  },
+});
+const current = new AsyncLocalStorage<
+  ReturnType<typeof database.reserve> extends Promise<infer T> ? T : never
+>();
+type Value = string | number | null;
+
+export async function tx<T>(work: () => Promise<T>): Promise<T> {
+  if (current.getStore()) return work();
+  const connection = await database.reserve();
+  try {
+    await connection.unsafe("begin");
+    // The original MVP serializes allocation, cancellations and deadline sweeps together.
+    await connection.unsafe("select pg_advisory_xact_lock(77662201)");
+    await connection.unsafe("set local search_path = moadam, pg_catalog");
+    const value = await current.run(connection, work);
+    await connection.unsafe("commit");
+    return value;
+  } catch (error) {
+    await connection.unsafe("rollback");
+    throw error;
+  } finally {
+    connection.release();
+  }
+}
+export async function all(
+  statement: string,
+  ...values: Value[]
+): Promise<any[]> {
+  const connection = current.getStore();
+  if (!connection) return tx(() => all(statement, ...values));
+  let index = 0;
+  return connection.unsafe(
+    statement.replace(/\?/g, () => "$" + ++index),
+    values,
+  );
+}
+export async function one(statement: string, ...values: Value[]) {
+  return (await all(statement, ...values))[0];
+}
+export async function run(statement: string, ...values: Value[]) {
+  const rows = await all(statement, ...values);
+  return { lastInsertRowid: rows[0]?.id };
+}
