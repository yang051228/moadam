+    [data, setData] = useState<any>({ me: null }),
+    [err, setError] = useState(""),
+    [loading, setLoading] = useState(false),
+    [login, setLoginOpen] = useState(false),
+    [account, setAccount] = useState("member"),
+    [dorm, setDorm] = useState("A"),
+    [notify, setNotify] = useState(true),
+    [notice, setNotificationsOpen] = useState(false),
+    [q, setSearch] = useState(""),
+    [type, setType] = useState("전체"),
+    [status, setStatus] = useState("전체"),
+    [category, setCategory] = useState("전체"),
+    [saved, setSaved] = useState<number[]>([]),
+    [sort, setDeadlineSort] = useState(false),
+    [onlySaved, setOnlySaved] = useState(false),
+    [msg, setMessage] = useState(""),
+    [rev, setRevision] = useState(0),
+    [now, setNow] = useState(0),
+    [next, setNextPage] = useState(""),
+    [authMode, setAuthMode] = useState("demo"),
+    [handle, setHandle] = useState(""),
+    [password, setPassword] = useState(""),
+    [authErr, setAuthError] = useState("");
+  const me = data.me,
+    groups: any[] = me
+      ? data.groups || []
+      : preview.map((g, i) => ({ ...g, deadline: now + (i + 1) * day })),
+    active = page.split("/")[0],
+    title =
+      nav.find((n) => n[0] === active)?.[1] ||
+      (active === "buy" ? "공구 상세" : "운영 대시보드");
+  async function refresh() {
+    try {
+      setData(await api("home"));
+      setError("");
+    } catch (e) {
+      setError((e as Error).message);
+    }
+  }
+  useEffect(() => {
+    setNow(Date.now());
+    const change = () => {
+      setPage(location.hash.slice(1) || "home");
+      window.scrollTo(0, 0);
+    };
+    change();
+    window.addEventListener("hashchange", change);
+    refresh();
+    const iv = setInterval(refresh, 18000);
+    return () => {
+      clearInterval(iv);
+      window.removeEventListener("hashchange", change);
+    };
+  }, []);
+  useEffect(() => {
+    try {
+      setSaved(
+        JSON.parse(
+          localStorage.getItem("saved-" + (me?.id || "preview")) || "[]",
+        ),
+      );
+    } catch {
+      setSaved([]);
+    }
+  }, [me?.id]);
+  useEffect(() => {
+    if (msg) {
+      const t = setTimeout(() => setMessage(""), 2800);
+      return () => clearTimeout(t);
+    }
+  }, [msg]);
+  function go(p: string) {
