+import { NextRequest, NextResponse } from "next/server";
+import { login, logout, user, accountLogin } from "../../../lib/db";
+import { browse, detail, admin, act } from "../../../lib/service";
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+const fail = (m: string, s: number) =>
+  NextResponse.json({ error: m }, { status: s });
+async function handler(req: NextRequest) {
+  const path = req.nextUrl.pathname.slice(5),
+    session = req.cookies.get("dm_session")?.value || "",
+    me = user(session);
+  try {
+    if (req.method === "GET") {
+      if (!me)
+        return path === "home"
+          ? NextResponse.json({ me: null })
+          : fail("로그인이 필요해요.", 401);
+      if (path === "home") return NextResponse.json(browse(me));
+      if (path === "admin") return NextResponse.json(admin(me));
+      if (/^buy\/\d+$/.test(path))
+        return NextResponse.json(detail(me, Number(path.split("/")[1])));
+      return fail("페이지를 찾을 수 없어요.", 404);
+    }
+    if (
+      req.headers.get("origin") &&
+      new URL(req.headers.get("origin")!).host !== req.headers.get("host")
+    )
+      return fail("요청 출처를 확인해 주세요.", 403);
+    const raw = await req.text();
+    if (raw.length > 800000) return fail("첨부파일을 줄여 주세요.", 413);
+    const a = JSON.parse(raw || "{}"),
+      opts = {
+        httpOnly: true,
+        sameSite: "lax" as const,
+        secure: req.nextUrl.protocol === "https:",
+        path: "/",
+      };
+    if (path === "signup" || path === "signin") {
+      const key = accountLogin(a, path === "signup");
+      if (session) logout(session);
+      const r = NextResponse.json({ ok: true });
+      r.cookies.set("dm_session", key, { ...opts, maxAge: 7 * 86400 });
+      return r;
+    }
+    if (path === "login") {
+      const keys = login(
+        req.cookies.get("dm_space")?.value || "",
+        a.account,
+        a.dorm,
+        a.notify !== false,
+      );
+      if (session) logout(session);
+      const r = NextResponse.json({ ok: true });
+      r.cookies.set("dm_space", keys.spaceKey, { ...opts, maxAge: 30 * 86400 });
+      r.cookies.set("dm_session", keys.session, { ...opts, maxAge: 7 * 86400 });
+      return r;
+    }
+    if (!me) return fail("로그인이 필요해요.", 401);
+    if (path === "logout") {
+      logout(session);
+      const r = NextResponse.json({ ok: true });
+      r.cookies.delete("dm_session");
+      return r;
+    }
+    if (path === "act") return NextResponse.json(act(me, a));
+    return fail("요청을 찾을 수 없어요.", 404);
+  } catch (e) {
+    return fail(
+      e instanceof Error &&
+        e.name !== "ZodError" &&
+        !e.message.includes("SQLITE")
+        ? e.message
+        : "입력값을 다시 확인해 주세요.",
+      400,
+    );
+  }
+}
+export const GET = handler,
+  POST = handler;
