+CREATE TABLE IF NOT EXISTS audit_logs(id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,buy INTEGER REFERENCES group_buys,uid INTEGER REFERENCES profiles,event TEXT NOT NULL,at BIGINT NOT NULL);
+CREATE TABLE IF NOT EXISTS credentials(uid INTEGER PRIMARY KEY REFERENCES profiles, salt TEXT NOT NULL, digest TEXT NOT NULL);
+CREATE TABLE IF NOT EXISTS login_attempts(handle TEXT PRIMARY KEY,attempts INTEGER NOT NULL,until BIGINT NOT NULL);
