+      <button className="primary" onClick={() => go("create")}>
+        운영자 공구 열기
+      </button>
+      <div className="section">
+        <h2>공구 관리</h2>
+        <select
+          aria-label="기숙사 필터"
+          value={dr}
+          onChange={(e) => B(e.target.value)}
+        >
+          {["전체", "A", "B"].map((s) => (
+            <option key={s}>{s}</option>
+          ))}
+        </select>
+        <select
+          aria-label="관리 상태"
+          value={f}
+          onChange={(e) => F(e.target.value)}
+        >
+          {["전체", "주문 지연", ...Object.values(stages)].map((s) => (
+            <option key={s}>{s}</option>
+          ))}
+        </select>
+      </div>
+      <div className="box">
+        {rows
+          .filter(
+            (g: any) =>
+              (dr === "전체" || dr === g.dorm) &&
+              (f === "전체" ||
+                (f === "주문 지연" ? late(g) : stages[g.status] === f)),
+          )
+          .map((g: any) => (
+            <div className="row" key={g.id}>
+              <div>
+                <b>{g.name}</b>
+                <p>
+                  {g.dorm}기숙사 · {stages[g.status]} · {g.people}명
+                </p>
+              </div>
+              {
+                <button className="chip" onClick={() => go("buy/" + g.id)}>
+                  관리
+                </button>
+              }
+            </div>
+          ))}
+      </div>
+      <h2>확인할 취소·미수령</h2>
+      <div className="box">
+        {d.queue.length
+          ? d.queue.map((r: any, i: number) => (
+              <div className="row" key={i}>
+                <span>
+                  {r.dorm}기숙사 · {r.name} · {r.kind}
+                </span>
+                {
+                  <button className="chip" onClick={() => go("buy/" + r.buy)}>
+                    확인
+                  </button>
+                }
+              </div>
+            ))
+          : "현재 확인할 건이 없어요."}
+      </div>
+      <h2>접수된 문제</h2>
+      <div className="box">
+        {d.entries.length
+          ? d.entries.map((r: any) => (
+              <div className="row" key={r.id}>
+                <span>
+                  {r.dorm}기숙사 · {r.name} · {r.kind}
+                </span>
+                <button className="chip" onClick={() => go("buy/" + r.buy)}>
+                  {r.status === "open" ? "접수 확인" : "처리 완료"}
+                </button>
+              </div>
+            ))
+          : "접수된 문제가 없어요."}
+      </div>
+    </>
+  );
+}
diff --git a/components/common.tsx b/components/common.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..085617f6e6eddd2b99a23a378e1a68146db08df9
--- /dev/null
+++ b/components/common.tsx
@@ -0,0 +1,161 @@
+"use client";
+import {
+  MapPin,
+  UsersRound,
+  Clock3,
+  Bookmark,
+  ShieldCheck,
+  GraduationCap,
+  X,
+} from "lucide-react";
+import { useRef, useEffect, useId } from "react";
+import { day, stages } from "../lib/catalog";
+export const won = (n: number) =>
+  new Intl.NumberFormat("ko-KR").format(n) + "원";
+export const date = (n: number) =>
+  new Intl.DateTimeFormat("ko-KR", {
+    timeZone: "Asia/Seoul",
+    month: "short",
+    day: "numeric",
+    hour: "2-digit",
+    minute: "2-digit",
+    hour12: false,
+  }).format(n);
+export const dday = (t: number) => {
+  const days = Math.ceil((t - Date.now()) / day);
+  return days <= 0 ? "마감" : days === 1 ? "마감 임박" : "D-" + days;
+};
+export function productImage(src: string) {
+  return src.startsWith("/art/")
+    ? (process.env.NEXT_PUBLIC_BASE_PATH || "") + src
+    : src;
+}
+export async function api(path: string, data?: unknown) {
+  const endpoint = process.env.NEXT_PUBLIC_MOADAM_API;
+  const headers: Record<string, string> = {};
+  if (data) headers["content-type"] = "application/json";
+  if (endpoint) {
+    const session = sessionStorage.getItem("moadam-session");
+    const space = sessionStorage.getItem("moadam-space");
+    if (session) headers["x-moadam-session"] = session;
+    if (space && path === "login") headers["x-moadam-space"] = space;
+  }
+  const r = await fetch((endpoint || "/api") + "/" + path, {
+    headers,
+    cache: "no-store",
+    method: data ? "POST" : "GET",
+    ...(data
+      ? {
+          body: JSON.stringify(data),
+        }
+      : {}),
+  });
+  const v = await r.json();
+  if (!r.ok) throw Error(v.error || "다시 시도해 주세요.");
+  if (endpoint) {
+    if (v.session) sessionStorage.setItem("moadam-session", v.session);
+    if (v.spaceKey) sessionStorage.setItem("moadam-space", v.spaceKey);
+    if (path === "logout") sessionStorage.removeItem("moadam-session");
+  }
+  return v;
+}
+export function Modal({
+  title,
+  close,
+  children,
+}: {
+  title: string;
+  close: () => void;
+  children: React.ReactNode;
+}) {
+  const titleId = useId();
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    ref.current?.showModal();
+  }, []);
+  return (
+    <dialog
+      aria-labelledby={titleId}
+      ref={ref}
+      onCancel={close}
+      className="modal"
+    >
+      <div className="section">
+        <h2 id={titleId}>{title}</h2>
+        <button className="icon" onClick={close} aria-label="닫기">
+          <X />
+        </button>
+      </div>
+      {children}
+    </dialog>
+  );
+}
+export function Card({
+  g,
+  open,
+  saved,
+  toggle,
+}: {
+  g: any;
+  open: () => void;
+  saved: boolean;
+  toggle: () => void;
+}) {
+  return (
+    <article className="product">
+      <div className={"photo " + g.category}>
+        <button
+          aria-label={g.name + " 상세 보기"}
+          className="photobtn"
+          onClick={open}
+        >
+          <img src={productImage(g.image)} alt={g.name} />
+        </button>
+        <span
+          className={
+            "time " +
+            (g.status === "open" && dday(g.deadline) === "마감 임박"
+              ? "urgent"
+              : "")
+          }
+        >
+          <Clock3 size={13} />
+          {g.status === "open" ? dday(g.deadline) : stages[g.status]}
+        </span>
+        <button
+          aria-label={saved ? "찜 해제" : "찜하기"}
+          aria-pressed={saved}
+          className={"bookmark " + (saved ? "saved" : "")}
+          onClick={toggle}
+        >
+          <Bookmark size={17} fill={saved ? "currentColor" : "none"} />
+        </button>
+      </div>
+      <button className="cardbody" onClick={open}>
+        <small className={"host " + (g.official ? "official" : "")}>
+          {g.official ? <ShieldCheck size={14} /> : <GraduationCap size={15} />}{" "}
+          {g.official ? "운영자 공구" : "학생 공구"}
+          <span>· {g.category}</span>
+        </small>
+        <h3>{g.name}</h3>
+        <div className="cost">
+          {won(Math.floor(g.price / g.lots))}{" "}
+          <small>/ {g.qty / g.lots}개</small>
+        </div>
+        <div className="progress">
+          <i style={{ width: (100 * g.used) / g.lots + "%" }} />
+        </div>
+        <div className="cardfoot">
+          <span>
+            <UsersRound size={14} />
+            {g.people}명 참여
+          </span>
+          <span>
+            <MapPin size={13} />
+            {g.place}
+          </span>
+        </div>
+      </button>
+    </article>
+  );
+}
