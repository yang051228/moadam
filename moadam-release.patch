+import { test, expect } from "@playwright/test";
+test("모바일 탐색·기숙사 인증·부담금·참여·취소", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.goto("/");
+  await expect(
+    page.getByRole("button", { name: "홈", exact: true }).last(),
+  ).toBeVisible();
+  expect(
+    await page.evaluate(
+      () => document.documentElement.scrollWidth <= innerWidth,
+    ),
+  ).toBe(true);
+  await page
+    .getByRole("button", { name: "도톰한 3겹 데일리 화장지 상세 보기" })
+    .click();
+  await page.getByRole("button", { name: "데모 인증하고 입장하기" }).click();
+  await page.getByRole("button", { name: "공구 참여하기" }).click();
+  await expect(page.getByRole("dialog")).toContainText(
+    "수령 5개 · 예상 분담금 3,150원",
+  );
+  await page.getByRole("button", { name: "확인하고 참여하기" }).click();
+  await expect(
+    page.getByRole("heading", { name: "내 참여 내역" }),
+  ).toBeVisible();
+  await page.getByRole("button", { name: "참여 취소", exact: true }).click();
+  await page
+    .getByRole("dialog")
+    .getByRole("button", { name: "확인", exact: true })
+    .click();
+  await expect(
+    page.getByRole("button", { name: "공구 참여하기" }),
+  ).toBeVisible();
+});
+test("데스크톱 학생 개설 폼·공유 링크·다른 사용자 동시 신청", async ({
+  page,
+  browser,
+  baseURL,
+}) => {
+  const suffix = Date.now().toString(),
+    password = "demo-password-123";
+  await page.goto("/");
+  await page
+    .getByRole("button", { name: "공구 열기", exact: true })
+    .first()
+    .click();
+  await page.getByRole("button", { name: "회원가입", exact: true }).click();
+  await page.getByLabel("아이디", { exact: true }).fill("host" + suffix);
+  await page.getByLabel("비밀번호", { exact: true }).fill(password);
+  await page.getByRole("button", { name: "개발용 인증으로 가입하기" }).click();
+  await page.getByLabel("원본 상품 링크").fill("https://example.org/demo");
+  await page.getByLabel("상품명", { exact: true }).fill("테스트 휴지");
+  await page.getByLabel("상품 이미지 URL").fill("/art/tissue.webp");
+  await page.getByLabel("총 가격 (원)").fill("7200");
+  await page.getByLabel("모집 단위 수").fill("1");
+  await page.getByRole("button", { name: "수령 일정 설정" }).click();
+  const date = (n: number) =>
+    new Date(Date.now() + 86400000 * n).toISOString().slice(0, 16);
+  await page.getByLabel("모집 마감 일시").fill(date(2));
+  await page.getByLabel("예상 주문 일시").fill(date(3));
+  await page.getByLabel("예정 수령 일시").fill(date(4));
+  await page.getByLabel("수령 장소", { exact: true }).fill("1층 로비");
+  for (const c of await page.locator("main input[type=checkbox]").all())
+    await c.check();
+  await page.getByRole("button", { name: "동의하고 공구 열기" }).click();
+  await expect(page.getByRole("heading", { name: "공구 안내" })).toBeVisible();
+  const url = page.url(),
+    id = Number(url.split("/").at(-1));
+  const contexts = await Promise.all([
+    browser.newContext({ baseURL }),
+    browser.newContext({ baseURL }),
+  ]);
+  try {
+    for (const [i, c] of contexts.entries()) {
+      const signup = await c.request.post("/api/signup", {
+        data: {
+          handle: "student" + i + suffix,
+          password,
+          dorm: "A",
+          notify: true,
+        },
+      });
+      expect(signup.ok()).toBe(true);
+    }
+    const result = await Promise.all(
+      contexts.map((c) =>
+        c.request.post("/api/act", { data: { action: "join", id, lots: 1 } }),
+      ),
+    );
+    expect(result.filter((r) => r.ok())).toHaveLength(1);
+    const p = await contexts[result.findIndex((x) => x.ok())].newPage();
+    await p.goto(url);
+    await expect(
+      p.getByRole("heading", { name: "내 참여 내역" }),
+    ).toBeVisible();
+    await expect(p.getByText(/분담금 7,200원/)).toBeVisible();
+  } finally {
+    await Promise.all(contexts.map((c) => c.close()));
+  }
+});
+test("비로그인 상세와 운영 API 차단", async ({ request }) => {
+  for (const path of ["admin", "buy/1"])
+    expect((await request.get("/api/" + path)).status()).toBe(401);
+});
